# Like Dockerfile, but with glibc 2.28 and SDL 2.0.9, for the binaries we build.
# The device is newer than this for both.
FROM debian:10-slim
RUN printf 'deb http://archive.debian.org/debian buster main\ndeb http://archive.debian.org/debian-security buster/updates main\n' > /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends libsdl2-2.0-0 xvfb imagemagick xdotool
